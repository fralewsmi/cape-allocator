# ── FRED API ──────────────────────────────────────────────────────────────────
# Free registration at: https://fred.stlouisfed.org/docs/api/api_key.html
# Used to fetch the 10-year TIPS real yield (series DFII10).
FRED_API_KEY=your_fred_api_key_here

# ── Cache settings (optional overrides) ──────────────────────────────────────
# CAPE_CACHE_URL=~/.cache/cape_allocator  # or s3://my-bucket for S3 backend
# CAPE_CACHE_TTL_HOURS=24

# ── Warmer schedule (optional override, EventBridge rate/cron expression) ─────
# WARMER_SCHEDULE=rate(12 hours)
